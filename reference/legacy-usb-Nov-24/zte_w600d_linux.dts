/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt/interrupt.h>

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	compatible = "zte,w600d-se", "rockchip,rk3568";
	model = "ZTE W600D SE Linux";

	memory {
		device_type = "memory";
		reg = <0x00 0x00000000 0x00 0x80000000>; /* 2GB - adjustable if needed */
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;
		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x00000000>;
		};
		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x00010000>;
		};
		cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x00020000>;
		};
		cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x00030000>;
		};
	};

	/* 
	 * Peripherals based on 中兴云电脑.dts 
	 * This is a synthesized DTS for mainline Linux boot.
	 */

	/* Serial console on UART2 */
	uart2: serial@fe660000 {
		compatible = "rockchip,rk3568-uart", "snps,dw-apb-uart";
		reg = <0x00 0xfe660000 0x00 0x100>;
		interrupts = <0x00 0x76 0x04>;
		clocks = <0x00 0x123 0x00 0x120>; /* Placeholder clocks */
		clock-names = "baudclk", "apb_pclk";
		status = "okay";
	};

	/* eMMC on mmc1 */
	mmc1: dwmmc@fe2c0000 {
		compatible = "rockchip,rk3568-dw-mshc", "rockchip,rk3288-dw-mshc";
		reg = <0x00 0xfe2c0000 0x00 0x4000>;
		interrupts = <0x00 0x63 0x04>;
		clocks = <0x00 0x123 0x00 0x124 0x00 0x125>; /* Placeholder */
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		status = "okay";
		supports-emmc;
		bus-width = <0x4>;
		non-removable;
	};

	/* USB Host for Keyboard/Mouse */
	usbhost0: usbhost@fd000000 {
		compatible = "rockchip,rk3568-dwc3", "rockchip,rk3399-dwc3";
		reg = <0x00 0xfd000000 0x00 0x400000>;
		interrupts = <0x00 0xaa 0x04>;
		dr_mode = "host";
		status = "okay";
	};

	/* eDP Display */
	edp: edp@fe0c0000 {
		compatible = "rockchip,rk3568-edp";
		reg = <0x00 0xfe0c0000 0x00 0x1000>;
		status = "okay";
	};

	/* PMIC and Regulators (RK809) */
	i2c0: i2c@fdd40000 {
		compatible = "rockchip,rk3399-i2c";
		reg = <0x00 0xfdd40000 0x00 0x1000>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		rk809: pmic@20 {
			compatible = "rockchip,rk809";
			reg = <0x20>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			vcc_ddr: regulator@3 {
				regulator-name = "vcc_ddr";
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xdbba0>;
				regulator-always-on;
				regulator-boot-on;
				status = "okay";
			};

			vcc_1v8: regulator@5 {
				regulator-name = "vcc_1v8";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-init-microvolt = <0x1b7740>;
				regulator-always-on;
				regulator-boot-on;
				status = "okay";
			};

			vcc_3v3: regulator@6 {
				regulator-name = "vcc_3v3";
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-init-microvolt = <0x325aa0>;
				regulator-always-on;
				regulator-boot-on;
				status = "okay";
			};

			vcc3v3_sd: regulator@7 {
				regulator-name = "vcc3v3_sd";
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-init-microvolt = <0x325aa0>;
				regulator-always-on;
				regulator-boot-on;
				status = "okay";
			};
		};
	};

	/* Keyboard Power Hog: GPIO3_A3 */
	keyboard_pwr: keyboard-pwr {
		compatible = "gpio-hog";
		reg = <0x00 0xfe760000 0x00 0x100>;
		gpio-hog;
		gpios = <3 3 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};
