+static int rk_edp_config_phy(struct rk_edp_priv *edp, const u8 *values,
+			     bool set_rate)
+{
+	struct rockchip_edp_phy_config config = {
+		.link_rate = edp->link_train.link_rate * 270,
+		.lanes = edp->link_train.lane_count,
+		.set_rate = set_rate,
+		.set_voltages = true,
+	};
+	unsigned int lane;
+
+	if (!edp->has_phy)
+		return 0;
+	for (lane = 0; lane < config.lanes; lane++) {
+		config.voltage[lane] = values[lane] & DP_TRAIN_VOLTAGE_SWING_MASK;
+		config.pre[lane] = (values[lane] & DP_TRAIN_PRE_EMPHASIS_MASK) >>
+				  DP_TRAIN_PRE_EMPHASIS_SHIFT;
+	}
+	return generic_phy_configure(&edp->phy, &config);
+}
